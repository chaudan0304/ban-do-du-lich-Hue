# ========================================
# .env.example - Mẫu cấu hình biến môi trường
# ========================================
# Copy file này thành .env và điền giá trị thật:
#   cp .env.example .env
#
# ⚠️ KHÔNG bao giờ commit file .env thật lên Git!

# Kết nối Neo4j Database
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASS=your_neo4j_password_here

# Flask Secret Key (dùng lệnh sau để tạo: python -c "import secrets; print(secrets.token_hex(32))")
FLASK_SECRET_KEY=your_secret_key_here
